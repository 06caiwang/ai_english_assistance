<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 主题 B：森系手账。只在这里定颜色与形状，页面里不要再写死色值 -->
    <style name="Base.Theme.Aienglish" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cozy_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/cozy_green_light</item>
        <item name="colorOnPrimaryContainer">@color/cozy_text</item>
        <item name="colorSecondary">@color/cozy_clay</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- 选中态（ToggleButton / Chip / 分段控件）默认会取这两个角色，
             不显式指定就会回落到 Material 基线紫色，与主题不搭 -->
        <item name="colorSecondaryContainer">@color/cozy_green_light</item>
        <item name="colorOnSecondaryContainer">@color/cozy_text</item>
        <!-- M3 的容器色分 5 档，Dialog 取 High、BottomSheet 取 Low，逐个落到主题色，
             否则会回落到基线紫色 -->
        <item name="colorSurfaceContainerLowest">@color/cozy_bg</item>
        <item name="colorSurfaceContainerLow">@color/cozy_card</item>
        <item name="colorSurfaceContainer">@color/cozy_card</item>
        <item name="colorSurfaceContainerHigh">@color/cozy_card</item>
        <item name="colorSurfaceContainerHighest">@color/cozy_card</item>
        <item name="colorSurfaceBright">@color/cozy_bg</item>
        <item name="colorSurfaceDim">@color/cozy_line</item>
        <item name="colorSurface">@color/cozy_card</item>
        <item name="colorOnSurface">@color/cozy_text</item>
        <item name="colorSurfaceVariant">@color/cozy_line</item>
        <item name="colorOnSurfaceVariant">@color/cozy_text_sub</item>
        <item name="colorOutline">@color/cozy_line</item>
        <item name="colorError">@color/danger</item>

        <item name="android:colorBackground">@color/cozy_bg</item>
        <item name="android:windowBackground">@color/cozy_bg</item>
        <item name="android:statusBarColor">@color/cozy_bg</item>
        <item name="android:navigationBarColor">@color/cozy_bg</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- 全局组件默认样式：新增页面自动继承，不用逐页写 -->
        <item name="materialButtonStyle">@style/Widget.Cozy.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Cozy.Card</item>
        <item name="textInputStyle">@style/Widget.Cozy.TextInput</item>
    </style>

    <style name="Theme.Aienglish" parent="Base.Theme.Aienglish" />

    <style name="Widget.Cozy.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Cozy.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Cozy.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/cozy_card</item>
        <item name="strokeColor">@color/cozy_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Cozy.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/cozy_card</item>
        <item name="boxStrokeColor">@color/cozy_line</item>
    </style>
</resources>
