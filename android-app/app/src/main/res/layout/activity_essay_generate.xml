<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cozy_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/cozy_text"
                android:textSize="26sp" />

            <TextView
                style="@style/Widget.Cozy.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="作文生成" />
        </LinearLayout>

        <!-- 便签：写要求 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_note"
            android:orientation="vertical"
            android:padding="16dp">

            <View
                android:layout_width="46dp"
                android:layout_height="6dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_tape" />

            <EditText
                android:id="@+id/etTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@null"
                android:hint="作文主题，如 My winter holiday"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/cozy_text"
                android:textColorHint="@color/cozy_text_sub"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/cozy_line" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="词数"
                android:textColor="@color/cozy_text_sub"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/groupWords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnW80"
                    style="@style/Widget.Cozy.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="80" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnW120"
                    style="@style/Widget.Cozy.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="120" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnW150"
                    style="@style/Widget.Cozy.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="150" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="难度"
                android:textColor="@color/cozy_text_sub"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/groupLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLJunior"
                    style="@style/Widget.Cozy.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="初中" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLSenior"
                    style="@style/Widget.Cozy.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="高中" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLCet4"
                    style="@style/Widget.Cozy.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="四级" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:text="生成" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- 便签：生成结果 -->
        <LinearLayout
            android:id="@+id/noteResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_note"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <View
                android:layout_width="46dp"
                android:layout_height="6dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_tape" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/Widget.Cozy.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cozy_text_sub"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEssay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/cozy_text"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
