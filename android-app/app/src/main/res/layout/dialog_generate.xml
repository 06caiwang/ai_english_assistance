<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutTopic"
            style="@style/Widget.Cozy.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="作文主题，如 My hometown">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="词数"
            android:textColor="@color/cozy_text_sub"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/groupWords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnW80"
                style="@style/Widget.Cozy.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="80" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnW120"
                style="@style/Widget.Cozy.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="120" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnW150"
                style="@style/Widget.Cozy.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="150" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="难度"
            android:textColor="@color/cozy_text_sub"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/groupLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLJunior"
                style="@style/Widget.Cozy.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="初中" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLSenior"
                style="@style/Widget.Cozy.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="高中" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLCet4"
                style="@style/Widget.Cozy.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="四级" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:text="生成作文" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
